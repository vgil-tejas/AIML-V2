# CyberSentinel — environment configuration.
# Copy: cp .env.example .env   then fill in real values.
# Every setting the backend reads is listed with its default and effect.
# (prod) = matters for the .23 deployment holding ~26M real logs.

# ── AI analyst ───────────────────────────────────────────────────────────────
# The ONLY feature that can send log data to an external service, and only when an
# analyst explicitly clicks an AI panel or runs a SOC query — never automatically.
# Easiest to configure with:  ./scripts/setup.sh
#   • Groq cloud : set GROQ_API_KEY (hosted, fastest).
#   • On-prem LLM: leave GROQ_API_KEY empty; set AI_BASE_URL to your own
#     OpenAI-compatible endpoint + AI_API_KEY + AI_MODEL/AI_FAST_MODEL. Nothing leaves.
#   • Disabled   : leave GROQ_API_KEY and AI_API_KEY empty — zero external calls.
GROQ_API_KEY=                        # empty -> AI features show "not configured"
GROQ_MODEL=llama-3.3-70b-versatile
# AI_API_KEY=                        # used for a non-Groq (on-prem) endpoint
# AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions   # override for on-prem
# AI_MODEL=llama-3.3-70b-versatile   # heavy model (currently unused by callers)
# AI_FAST_MODEL=llama-3.1-8b-instant # the model ALL AI features actually use
LOG_LEVEL=INFO

# ── ClickHouse store ─────────────────────────────────────────────────────────
CLICKHOUSE_ENABLED=true
CLICKHOUSE_PASS=change-me            # (prod) REQUIRED when enabled — boot fails fast if empty
CLICKHOUSE_MEM_LIMIT=8G              # (prod) raise to ~24G on the 26M box

# ── Read-path safety (runbook §3/§5) ─────────────────────────────────────────
READ_MAX_SECONDS=30                  # hard per-query time budget; a slower query is killed
READ_MAX_ROWS=300000000             # runaway backstop (well above 26M so real aggregates pass)
LOGS_MAX_WINDOW_MINUTES=43200        # 30d — server clamps any larger /api/logs window (no full scan)
READ_CONCURRENCY=8                   # max concurrent heavy ClickHouse queries (admission gate)
READ_ADMIT_WAIT=2.0                  # seconds a request waits for a slot before serving stale cache
WARM_FAST_SECONDS=60                 # dashboard cache-warm cadence
WARM_INCIDENTS_SECONDS=180

# ── Migrations ───────────────────────────────────────────────────────────────
RUN_MIGRATIONS_ON_START=true         # apply pending additive migrations at boot (idempotent)
ALLOW_DESTRUCTIVE=false              # (prod) NEVER true — runner refuses DROP/DELETE/TRUNCATE unless set

# ── Security / hardening ─────────────────────────────────────────────────────
CS_CORS_ORIGINS=*                    # (prod) comma-separated allowlist, e.g. https://soc.bank.internal
CS_MAX_BODY_MB=550                   # request body cap (above the 500MB upload limit)
CS_ADMIN_TOKEN=                      # (prod) set to gate /health/detail (Bearer token or ?token=)

# ── External threat-intel connectors (optional; fail-soft if absent) ─────────
ABUSEIPDB_KEY=
VT_KEY=
GREYNOISE_KEY=
OTX_KEY=
SHODAN_KEY=
INTEL_CACHE_TTL_HOURS=24

# ── Login gate (single operator) ────────────────────────────────────────────
# The dashboard requires a login. One account, enforced at nginx + backend.
AUTH_ENABLED=true                    # set false to open the dashboard (no login)
AUTH_USER=Tejas                      # the one allowed username
AUTH_PASS=tejas@123                  # the one allowed password — CHANGE for prod
AUTH_SECRET=                         # HMAC key for the session cookie; empty =
                                     #   derived from AUTH_PASS. Set a long random
                                     #   value in prod:  openssl rand -hex 32
AUTH_TTL_HOURS=12                    # how long a login stays valid
AUTH_COOKIE_SECURE=false             # set true ONLY when served over HTTPS

# ── Demo mode (writes synthetic attack rows — NEVER on prod) ─────────────────
DEMO_MODE=false                      # true only on a demo/dev box

# ── Ingestion watcher (already production-grade — do not redesign) ───────────
WAZUH_ALERTS_PATH=/var/ossec/logs/alerts/alerts.json
WAZUH_BATCH_SIZE=5000

# ── Host ports (19xxx — free on server, no clash with the Wazuh stack) ───────
NGINX_HOST_PORT=19888
FRONTEND_HOST_PORT=19180
BACKEND_HOST_PORT=19110
ML_ENGINE_HOST_PORT=19111
CLICKHOUSE_HTTP_PORT=19123
CLICKHOUSE_NATIVE_PORT=19000
