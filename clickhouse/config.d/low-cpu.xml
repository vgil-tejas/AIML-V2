<?xml version="1.0"?>
<!--
  CPU-bounded profile for constrained hosts (e.g. a 12-core bank VM).

  IMPORTANT: the main CPU lever — per-query thread capping — is done APP-SIDE, not
  here. The backend sends `max_threads` on every read via READ_MAX_THREADS
  (backend/clickhouse_client.py, default 4). That is what actually keeps queries
  off all 12 cores, and it works regardless of this file.

  This file sets only ONE server-level guardrail that is safe in ClickHouse 24.3:
  a cap on how many queries may run at once, so a dashboard burst can't fan out
  over every core. Tunable via CH_MAX_CONCURRENT_QUERIES in the compose file.

  DO NOT re-add `background_pool_size` or a `<profiles><default><max_threads>`
  block here. In ClickHouse 24.3 those forms are rejected when the SERVER config
  is loaded, and the server crash-loops on startup (it did — the store went down
  on 2026-08-01). Server-level settings only in config.d; profile/thread settings
  belong in users.d, and default merge concurrency is already fine on 12 cores.
-->
<clickhouse>
    <max_concurrent_queries from_env="CH_MAX_CONCURRENT_QUERIES"/>
</clickhouse>
