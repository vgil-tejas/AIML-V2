<mxfile host="app.diagrams.net" modified="2026-10-23" agent="CyberSentinel"><diagram name="Architecture &amp; Pipeline" id="cs-arch"><mxGraphModel dx="1600" dy="1070" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="feed" value="<b>Alert feed  (alerts.json)</b><br>100k – millions of events/day  ·  read-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2430;strokeColor=#3a4152;fontColor=#e6e8ee;fontSize=12;verticalAlign=top;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="560" y="16" width="480" height="58" as="geometry"/></mxCell>
<mxCell id="coll" value="<b>CyberSentinel Collector</b><br>byte-offset tail  ·  smart filter<br>batch (5000) + disk spool  →  zero loss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5e6ad2;strokeColor=#4954b8;fontColor=#ffffff;fontSize=12;verticalAlign=top;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="116" width="600" height="86" as="geometry"/></mxCell>
<mxCell id="norm" value="<b>CyberSentinel Normaliser</b><br>flatten  ·  classify threat_type + severity<br>extract ATT&amp;CK / geo / process / FIM  →  map 41-col row" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5e6ad2;strokeColor=#4954b8;fontColor=#ffffff;fontSize=12;verticalAlign=top;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="232" width="600" height="94" as="geometry"/></mxCell>
<mxCell id="store" value="<b>Event Store  —  ClickHouse 24.3</b><br>logs: MergeTree, day-partition, ZSTD, 90/180d TTL, 41 cols<br>rollups: mv_ip_daily → agg_ip_daily · mv_threat_hourly → agg_threat_hourly<br>state / SOAR / auth tables (baselines, cases, ml_scores, cs_users…)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d3545;strokeColor=#434c60;fontColor=#e6e8ee;fontSize=12;verticalAlign=top;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="430" y="372" width="740" height="158" as="geometry"/></mxCell>
<mxCell id="risk" value="<b>Risk Engine  (ml-engine)</b><br>Isolation Forest, 19-feature vector<br>anomaly + deviation + intel → 0–100<br>auto-retrain · subnet clustering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a78bfa;strokeColor=#8b6ee0;fontColor=#1a1430;fontSize=12;verticalAlign=top;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="250" y="596" width="440" height="150" as="geometry"/></mxCell>
<mxCell id="back" value="<b>Backend  —  FastAPI v2.2.0</b><br>entity-risk · UEBA · ATT&amp;CK / kill-chain<br>incident correlation · 18 detections<br>telemetry intel · NL→SQL · SOAR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4cb782;strokeColor=#3a9e6c;fontColor=#08130d;fontSize=12;verticalAlign=top;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="740" y="596" width="520" height="150" as="geometry"/></mxCell>
<mxCell id="egress" value="<b>External egress (optional)</b><br>LLM — Groq gpt-oss-120b / 20b<br>Intel — AbuseIPDB · VirusTotal ·<br>GreyNoise · OTX · Shodan<br><br>Boundary: only sanitised decoys<br>leave; restored on-prem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a1f27;strokeColor=#eb5757;fontColor=#ffd9de;fontSize=12;verticalAlign=top;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1300" y="566" width="440" height="214" as="geometry"/></mxCell>
<mxCell id="gw" value="<b>Gateway  —  nginx + single login gate</b><br>port 19888  ·  auth_request  ·  rate-limit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2994a;strokeColor=#d97f33;fontColor=#1f1403;fontSize=12;verticalAlign=top;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="820" width="600" height="64" as="geometry"/></mxCell>
<mxCell id="dash" value="<b>Dashboard  —  SOC console</b><br>SPA + Overview deck + split pages (soft-nav pjax)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5e6ad2;strokeColor=#4954b8;fontColor=#ffffff;fontSize=12;verticalAlign=top;spacing=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="930" width="600" height="78" as="geometry"/></mxCell>
